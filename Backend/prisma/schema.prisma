// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Servicio {
  id                    Int                  @id @default(autoincrement())
  nombre                String               @db.VarChar(100)
  precio                Float
  descripcion           String?              @db.VarChar(200)
  activo                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  cotizacionesServicios CotizacionServicio[]

  @@map("servicios")
}

model Local {
  id             Int          @id @default(autoincrement())
  nombre         String
  precio         Int
  contacto       String?
  nombreDueno    String
  aforo          Int
  direccion      String
  disponibilidad Boolean      @default(true)

  cotizaciones   Cotizacion[]

  @@map("locales")
}

model Cotizacion {
  id               Int      @id @default(autoincrement())
  cantidadPersonas Int
  valorTotal       Float
  abono            Float
  estado           String   @default("pendiente")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  localId          Int?
  local            Local?   @relation(fields: [localId], references: [id])

  cotizacionesServicios CotizacionServicio[]
  evento                Evento?

  @@map("cotizaciones")
}

model CotizacionServicio {
  id           Int        @id @default(autoincrement())
  cotizacionId Int
  servicioId   Int

  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  servicio     Servicio   @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@map("cotizaciones_servicios")
}

model Evento {
  id           Int        @id @default(autoincrement())
  nombre       String     @db.VarChar(100)
  fecha        DateTime
  cotizacionId Int        @unique
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])

  contrataciones Contratacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
   valoraciones Valoracion[] 
  localId          Int?
  local            Local?   @relation(fields: [localId], references: [id])

  cotizacionesServicios CotizacionServicio[]
  evento                Evento?

  @@map("cotizaciones")
}

model CotizacionServicio {
  id           Int        @id @default(autoincrement())
  cotizacionId Int
  servicioId   Int

  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  servicio     Servicio   @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@map("cotizaciones_servicios")
}

model Evento {
  id           Int        @id @default(autoincrement())
  nombre       String     @db.VarChar(100)
  fecha        DateTime
  cotizacionId Int        @unique
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])

  contrataciones Contratacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  valoraciones Valoracion[] 
  @@map("eventos")
}

enum Rol {
  admin
  cliente
  externo
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  apellido  String
  telefono  String?
  rol       String   @default("cliente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   valoracionesHechas     Valoracion[] @relation("ValoracionAutor")
   valoracionesRecibidas  Valoracion[] @relation("ValoracionTrabajador")

  @@map("usuarios")
}

model Articulo {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  cantidad  Int       
  enUso     Boolean  @default(true)

  @@map("articulos")
}

model Vehiculo {
  id        Int      @id @default(autoincrement())
  marca     String   @db.VarChar(100)
  modelo    String   @db.VarChar(100)
  patente   String   @db.VarChar(100)
  disponible Boolean  @default(true)

  @@map("vehiculos")
}

model Personal {
  id             Int            @id @default(autoincrement())
  nombre         String
  apellido       String
  telefono       String?
  calificacion   Int?
  contrataciones Contratacion[]
}

model Contratacion {
  id          Int      @id @default(autoincrement())
  id_personal Int
  id_evento   Int
  fecha       String?
  salario     Int

  personal Personal @relation(fields: [id_personal], references: [id])
  evento   Evento   @relation(fields: [id_evento], references: [id])
}
model Valoracion {
 id             Int @id   @default(autoincrement())
 calificacion   Int
 comentario     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  //autor coso
  autorId       Int
  autor         Usuario @relation("ValoracionAutor", fields: [autorId], references: [id], onDelete: Cascade)
  eventoId      Int?
  evento        Evento? @relation(fields: [eventoId], references: [id], onDelete:Cascade)

  //trabajador
  trabajadorId    Int?
  trabajador      Usuario? @relation("ValoracionTrabajador", fields: [trabajadorId], references: [id], onDelete: Cascade)

  @@unique([autorId, trabajadorId])
  @@unique([autorId, eventoId])
  @@map("valoraciones")
  @@index([trabajadorId])
  @@index([eventoId])
}