generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Evento {
  id               Int      @id @default(autoincrement())
  nombre           String   @db.VarChar(100)
  tipo             String   @db.VarChar(100)
  fecha            DateTime
  cantidadPersonas Int
  valorTotal       Float
  abono            Float
  confirmado       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  valoraciones Valoracion[] 
  @@map("eventos")
}

enum Rol {
  admin
  cliente
  externo
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  apellido  String
  telefono  String?
  rol       String   @default("cliente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   valoraciones Valoracion[] 

  @@map("usuarios")
}

model Valoracion {
 id             Int @id   @default(autoincrement())
 calificacion   Int
 comentario     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  //autor coso
  autorId       Int
  autor         Usuario @relation("ValoracionAutor", fields: [autorId], references: [id], onDelete: Cascade)
  eventoId      Int?
  evento        Evento? @relation(fields: [eventoId], references: [id], onDelete:Cascade)

  //trabajador
  trabajadorId    Int?
  trabajador      Usuario? @realtion("ValoracionTrabajador", fields:
  [trabajadorId], references: [id], onDelete: Cascade)

  @@unique([autorId, trabajadorId])
  @@unique([autorId, eventoId])
  @@map("valoraciones")
  @@index([trabajadorId])
  @@index([eventoId])
}