generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Servicio {
  id                    Int                  @id @default(autoincrement())
  nombre                String               @db.VarChar(100)
  precio                Float
  descripcion           String?              @db.VarChar(200)
  activo                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  cotizacionesServicios CotizacionServicio[]

  @@map("servicios")
}

model Cotizacion {
  id                    Int                  @id @default(autoincrement())
  cantidadPersonas      Int
  valorTotal            Float
  abono                 Float
  estado                String               @default("pendiente")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  cotizacionesServicios CotizacionServicio[]
  evento                Evento?

  @@map("cotizaciones")
}

model CotizacionServicio {
  id           Int        @id @default(autoincrement())
  cotizacionId Int
  servicioId   Int

  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  servicio     Servicio   @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  @@map("cotizaciones_servicios")
}

model Evento {
  id                   Int        @id @default(autoincrement())
  local                String     @db.VarChar(100)
  fecha                DateTime
  cotizacionId         Int        @unique
  cotizacion           Cotizacion @relation(fields: [cotizacionId], references: [id])
  //trabajadores       Trabajador[] //Ponlo como contratacion
  //vehiculos          Vehiculo[]
  //equipos            Equipo[]

  contrataciones       Contratacion[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("eventos")
}

enum Rol {
  admin
  cliente
  externo
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  apellido  String
  telefono  String?
  rol       String   @default("cliente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

model Articulo {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  cantidad  Int       
  enUso     Boolean  @default(true)

  @@map("articulos")
}

model Vehiculo {
  id        Int      @id @default(autoincrement())
  marca     String   @db.VarChar(100)
  modelo    String   @db.VarChar(100)
  patente   String   @db.VarChar(100)
  disponible Boolean  @default(true)

  @@map("vehiculos")
}
model Personal {
  id            Int      @id @default(autoincrement())
  nombre        String
  apellido      String
  telefono      String?
  calificacion  Int?
  contrataciones  Contratacion[]
}

model Contratacion {
  id            Int           @id @default(autoincrement())
  id_personal   Int       
  id_evento     Int
  fecha         String?
  salario       Int

  personal      Personal      @relation(fields:[id_personal], references: [id])
  evento        Evento        @relation(fields:[id_evento], references: [id])
}
