  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión (guarda token para valoraciones)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\nif (response.success && response.data && response.data.token) {\n  pm.collectionVariables.set('token', response.data.token);\n} else {\n  throw new Error('No se recibió un token. Revisa las credenciales y la respuesta del login.');\n}\n\npm.test('Status code is 200 or 201', function () {\n    pm.expect(pm.response.code).to.be.oneOf([\n        200,\n        201\n    ]);\n})\n\npm.test('Response is JSON', function () {\n    pm.response.to.be.json;\n})\n\npm.test('Response time is under 5000ms', function () {\n    pm.expect(pm.response.responseTime).to.be.below(5000);\n})"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailLogin}}\",\n  \"password\": \"{{passwordLogin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
