  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const idVariables = {",
          "  'Crear artículo': 'articuloId',",
          "  'Crear usuario': 'usuarioId',",
          "  'Crear vehículo': 'vehiculoId',",
          "  'Crear local': 'localId',",
          "  'Crear servicio': 'servicioId',",
          "  'Crear cotización': 'cotizacionId',",
          "  'Crear relación cotización-servicio': 'cotizacionServicioId',",
          "  'Crear evento': 'eventoId',",
          "  'Crear persona': 'personalId',",
          "  'Crear contratación': 'contratacionId',",
          "  'Crear valoración de trabajador': 'valoracionId'",
          "};",
          "const variableName = idVariables[pm.info.requestName];",
          "if (variableName && pm.response.code >= 200 && pm.response.code < 300) {",
          "  const response = pm.response.json();",
          "  const created = response.data || response;",
          "  if (!created.id) {",
          "    throw new Error('La respuesta de creación no contiene un ID para ' + pm.info.requestName);",
          "  }",
          "  pm.collectionVariables.set(variableName, String(created.id));",
          "  if (pm.info.requestName === 'Crear usuario') {",
          "    pm.collectionVariables.set('trabajadorId', String(created.id));",
          "  }",
          "}"
        ]
      }
    }
